{
  "name": "party-plot-booker",
  "version": "1.0.0",
  "description": "Party Plot Booking Application - Find and book party venues near you",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:api": "npm install --prefix netlify/functions && tsc --project tsconfig.netlify.json",
    "start": "npm run start --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client && npm install --prefix netlify/functions",
    "seed": "npm run seed --prefix server",
    "netlify:dev": "netlify dev",
    "netlify:build": "npm run build && npm run build:api"
  },
  "dependencies": {
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@netlify/functions": "^2.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.5",
    "concurrently": "^8.2.2",
    "netlify-cli": "^17.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}