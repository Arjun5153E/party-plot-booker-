{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "netlify/functions/dist",
    "rootDir": "netlify/functions",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@utils/*": ["netlify/functions/utils/*"],
      "@middleware/*": ["netlify/functions/middleware/*"],
      "@models/*": ["netlify/functions/utils/Models"],
      "@server/*": ["server/src/*"]
    }
  },
  "include": ["netlify/functions/**/*"],
  "exclude": ["node_modules", "dist", "client", "netlify/functions/dist"]
}